# Bitacora root environment

INFRA_APP_NAME=bitacora
INFRA_PROFILE=next-only
INFRA_ROOT_DOMAIN=bitacora.hashpass.tech
INFRA_HOSTED_ZONE_DOMAIN=hashpass.tech
INFRA_PIPELINE_REPO=hashpass-tech/BITACORA
INFRA_PIPELINE_PREFIX=bitacora
INFRA_PROJECT_TAG=bitacora
INFRA_PIPELINES=production,dev
INFRA_PIPELINE_BRANCH_PROD=main
INFRA_PIPELINE_BRANCH_DEV=develop
INFRA_PIPELINE_PERMISSIONS_MODE=admin
INFRA_CREATE_PIPELINES=false
AWS_REGION=us-east-1

# Secret values are intentionally omitted from the example file.
DATABASE_URL=YOUR_DATABASE_URL
AUTH_SECRET=YOUR_AUTH_SECRET
