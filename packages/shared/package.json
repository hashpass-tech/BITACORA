{
  "name": "@bitacora/shared",
  "version": "0.1.7",
  "private": true,
  "description": "Shared utilities, types, and hooks for Bitacora",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./store": {
      "import": "./dist/store.js",
      "require": "./dist/store.js",
      "types": "./dist/store.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "lint": "eslint src",
    "test": "vitest --run"
  },
  "dependencies": {
    "tweetnacl": "^1.0.3",
    "tweetnacl-util": "^0.15.1",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "fast-check": "^3.13.0",
    "typescript": "~5.9.2",
    "vitest": "^1.0.0"
  }
}
