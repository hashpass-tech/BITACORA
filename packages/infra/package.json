{
  "name": "@bitacora/infra",
  "version": "0.1.7",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit",
    "deploy": "sst deploy",
    "deploy:dev": "sst deploy --stage dev",
