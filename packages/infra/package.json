    "ensure:pipelines": "APPROVE=true bash scripts/ensure-pipelines.sh"
  },
  "dependencies": {
    "@lsts_tech/infra": "^1.0.3",
    "sst": "^3.7.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20"
  }
}
